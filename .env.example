# Copie este arquivo para ".env" e preencha com sua chave real.
# Nunca compartilhe ou suba o arquivo .env para a internet.

# Chave gratuita: crie em https://console.groq.com/keys (não pede cartão)
GROQ_API_KEY=sua_chave_aqui

# Opcional: troque o modelo (padrão: openai/gpt-oss-120b, robusto e rápido no Groq).
# Para respostas ainda mais rápidas (um pouco menos "espertas"), use: openai/gpt-oss-20b
# A lista de modelos disponíveis na sua conta pode mudar; confira em
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Voz de IA (opcional, mas recomendado): crie uma chave grátis em
# https://elevenlabs.io (Profile → API Keys). Sem cartão pra começar.
# Sem essa chave, o app usa a voz padrão do navegador/Android como reserva.
ELEVENLABS_API_KEY=sua_chave_aqui

# Opcional: troque a voz. O padrão é "Adam" (masculina, grave).
# Navegue outras vozes em https://elevenlabs.io/app/voice-library,
# copie o "Voice ID" dela (nos "..." da voz) e cole aqui.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Opcional: modelo de voz (padrão já funciona bem em português)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Opcional: porta do servidor (padrão: 3000)
PORT=3000
